# Application
APP_NAME=journal-app
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=journal
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSLMODE=disable

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# Logging
LOG_LEVEL=info

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRED_HOURS=24

# External Services
API_BASE_URL=https://api.example.com
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=your_rustfs_key
RUSTFS_SECRET_KEY=your_rustfs_secret
RUSTFS_BUCKET=journal-attachments

# Timezone
TZ=Asia/Jakarta