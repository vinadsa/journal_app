# ============================================================
# TRACE — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Application
APP_NAME=journal-app
APP_ENV=development              # Set to 'production' for JSON structured logs & secure cookies
APP_PORT=8080
APP_DEBUG=true

# Database (also used by Docker Compose for PostgreSQL container)
DB_HOST=localhost                 # Use 'db' when running via Docker Compose
DB_PORT=5432
DB_NAME=journal
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSLMODE=disable

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# Logging
LOG_LEVEL=info

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRED_HOURS=24

# External Services
API_BASE_URL=https://api.example.com
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=your_rustfs_key
RUSTFS_SECRET_KEY=your_rustfs_secret
RUSTFS_BUCKET=journal-attachments

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Timezone
TZ=Asia/Jakarta

# Docker Compose (optional overrides)
FRONTEND_PORT=3000               # Host port for the Nginx frontend container