# ============================================================
# TRACE Backend — Multi-Stage Production Dockerfile
# Stage 1: Build Go binary with optimizations
# Stage 2: Minimal Alpine runtime with non-root user
# ============================================================

# --- Stage 1: Builder ---
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

# Cache module downloads (changes less frequently than source)
COPY go.mod go.sum ./
RUN go mod download

# Copy source and compile
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /build/trace-server \
    ./cmd/server

# --- Stage 2: Minimal Runtime ---
FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup -u 1001

WORKDIR /app

# Copy compiled binary from builder
COPY --from=builder /build/trace-server .

# Ensure binary is executable
RUN chmod +x ./trace-server

# Switch to non-root user
USER appuser

EXPOSE 8080

ENTRYPOINT ["./trace-server"]
